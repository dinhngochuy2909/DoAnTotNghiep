                            child: Row(
                              children: [
                                Icon(Icons.delete_outline, color: Color(0xFFEF4444), size: 16),
                                SizedBox(width: 8),
                                Text('XÃ³a khÃ¡ch', style: TextStyle(color: Color(0xFFEF4444), fontSize: 13)),

  Widget _buildBookingItemCard(BookingItem b) {
    Color statusColor = const Color(0xFFF59E0B);
    if (b.status == 'ÄÃ£ xÃ¡c nháº­n') statusColor = const Color(0xFF10B981);
    if (b.status == 'HoÃ n thÃ nh') statusColor = const Color(0xFF6366F1);
    if (b.status == 'ÄÃ£ há»§y') statusColor = const Color(0xFFEF4444);

    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: const Color(0xFF1E293B),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFF334155)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                children: [
                  Text(
                    b.id,
                    style: const TextStyle(
                        color: Color(0xFF818CF8), fontWeight: FontWeight.bold, fontFamily: 'monospace'),
                  ),
                  const SizedBox(width: 8),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                    decoration: BoxDecoration(
                      color: statusColor.withOpacity(0.15),
                      borderRadius: BorderRadius.circular(6),
                      border: Border.all(color: statusColor.withOpacity(0.4)),
                    ),
                    child: Text(
                      b.status,
                      style: TextStyle(color: statusColor, fontSize: 11, fontWeight: FontWeight.bold),
                    ),
                  ),
                ],
              ),
              Text(
                b.amount,
                style: const TextStyle(color: Color(0xFF10B981), fontWeight: FontWeight.bold, fontSize: 15),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Row(
            children: [
              const Icon(Icons.person, color: Color(0xFF94A3B8), size: 14),
              const SizedBox(width: 4),
              Text(b.customer,
                  style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w600, fontSize: 13)),
              const SizedBox(width: 12),
              const Icon(Icons.phone, color: Color(0xFF94A3B8), size: 14),
              const SizedBox(width: 4),
              Text(b.phone, style: const TextStyle(color: Color(0xFF94A3B8), fontSize: 12)),
            ],
          ),
          const SizedBox(height: 4),
          Row(
            children: [
              const Icon(Icons.sports_tennis, color: Color(0xFF94A3B8), size: 14),
              const SizedBox(width: 4),
              Expanded(
                child: Text('${b.venueName} (${b.field})',
                    style: const TextStyle(color: Color(0xFFCBD5E1), fontSize: 12),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis),
              ),
            ],
          ),
          const SizedBox(height: 4),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                children: [
                  const Icon(Icons.access_time, color: Color(0xFF94A3B8), size: 14),
                  const SizedBox(width: 4),
                  Text('${b.time} â€¢ ${b.date}',
                      style: const TextStyle(color: Color(0xFF94A3B8), fontSize: 12)),
                ],
              ),
              // Action buttons (Approve, Complete, Cancel)
              Row(
                children: [
                  if (b.status == 'Chá» xÃ¡c nháº­n') ...[
                    IconButton(
                      icon: const Icon(Icons.check_circle_outline, color: Color(0xFF10B981), size: 22),
                      tooltip: 'XÃ¡c nháº­n Ä‘Æ¡n',
                      onPressed: () async {
                        await FirestoreService.updateBookingStatus(b.id, 'ÄÃ£ xÃ¡c nháº­n');
                        setState(() => b.status = 'ÄÃ£ xÃ¡c nháº­n');
                        _showToast('ÄÃ£ xÃ¡c nháº­n Ä‘Æ¡n ${b.id}!');
                      },
                    ),
                    IconButton(
                      icon: const Icon(Icons.cancel_outlined, color: Color(0xFFEF4444), size: 22),
                      tooltip: 'Há»§y Ä‘Æ¡n',
                      onPressed: () async {
                        await FirestoreService.updateBookingStatus(b.id, 'ÄÃ£ há»§y');
                        setState(() => b.status = 'ÄÃ£ há»§y');
                        _showToast('ÄÃ£ há»§y Ä‘Æ¡n ${b.id}!', isError: true);
                      },
                    ),
                  ],
                  if (b.status == 'ÄÃ£ xÃ¡c nháº­n') ...[
                    IconButton(
                      icon: const Icon(Icons.done_all, color: Color(0xFF6366F1), size: 22),
                      tooltip: 'ÄÃ¡nh dáº¥u hoÃ n thÃ nh',
                      onPressed: () async {
                        await FirestoreService.updateBookingStatus(b.id, 'HoÃ n thÃ nh');
                        setState(() => b.status = 'HoÃ n thÃ nh');
                        _showToast('ÄÆ¡n ${b.id} Ä‘Ã£ hoÃ n thÃ nh!');
                      },
                    ),
                  ],
                ],
              ),
            ],
          ),
        ],
      ),
    );
  }


                            ),
                          ),
                          PopupMenuItem(
                            value: 'toggle_status',
                            child: Row(
                              children: [
                                Icon(isLocked ? Icons.lock_open : Icons.lock_outline, color: const Color(0xFFFBBF24), size: 16),
                                SizedBox(width: 8),
                                Text(isLocked ? 'Má»Ÿ khÃ³a tÃ i khoáº£n' : 'Táº¡m khÃ³a tÃ i khoáº£n', style: const TextStyle(color: Colors.white, fontSize: 13)),
                              ],

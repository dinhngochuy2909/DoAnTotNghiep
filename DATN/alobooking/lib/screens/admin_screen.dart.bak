  Widget _filterChip(String key, String label) {
    final selected = _selectedSport == key;
    return Padding(
      padding: const EdgeInsets.only(right: 6),
      child: ChoiceChip(
        label: Text(label),
        selected: selected,
        onSelected: (_) => setState(() => _selectedSport = key),
        selectedColor: const Color(0xFF10B981),
        backgroundColor: const Color(0xFF0F172A),
        labelStyle: TextStyle(
          color: selected ? Colors.white : const Color(0xFF94A3B8),
          fontSize: 12,
          fontWeight: selected ? FontWeight.bold : FontWeight.normal,
        ),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
        side: BorderSide(color: selected ? const Color(0xFF10B981) : const Color(0xFF334155)),
      ),
    );
  }

  Widget _approvalFilterChip(String key, String label) {
    final selected = _selectedApprovalFilter == key;
    return ChoiceChip(
      label: Text(label),
      selected: selected,
      onSelected: (_) => setState(() => _selectedApprovalFilter = key),
      selectedColor: key == 'pending' ? const Color(0xFFFBBF24) : const Color(0xFF10B981),
      backgroundColor: const Color(0xFF0F172A),
      labelStyle: TextStyle(
        color: selected
            ? (key == 'pending' ? Colors.black : Colors.white)
            : const Color(0xFF94A3B8),
        fontSize: 12,
        fontWeight: selected ? FontWeight.bold : FontWeight.normal,
      ),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
      side: BorderSide(
        color: selected
            ? (key == 'pending' ? const Color(0xFFFBBF24) : const Color(0xFF10B981))
            : const Color(0xFF334155),
      ),
    );
  }

  Widget _buildVenueRowCard(Venue v) {
    Color statusBg = const Color(0xFF10B981).withOpacity(0.15);
    Color statusColor = const Color(0xFF10B981);
    String statusText = 'ÄÃ£ duyá»‡t';

    if (v.isPending) {
      statusBg = const Color(0xFFFBBF24).withOpacity(0.15);
      statusColor = const Color(0xFFFBBF24);
      statusText = 'Chá» duyá»‡t';
    } else if (v.isRejected) {
      statusBg = const Color(0xFFEF4444).withOpacity(0.15);
      statusColor = const Color(0xFFEF4444);
      statusText = 'Tá»« chá»‘i';
    }

    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: const Color(0xFF1E293B),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: v.isPending ? const Color(0xFFFBBF24).withOpacity(0.6) : const Color(0xFF334155),
          width: v.isPending ? 1.5 : 1.0,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              // Image
              ClipRRect(
                borderRadius: BorderRadius.circular(10),
                child: VenueImageView(
                  imageUrl: v.image,
                  width: 75,
                  height: 75,
                  fit: BoxFit.cover,
                ),
              ),
              const SizedBox(width: 14),

              // Info
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Container(
                          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                          decoration: BoxDecoration(
                            color: const Color(0xFF10B981).withOpacity(0.15),
                            borderRadius: BorderRadius.circular(6),
                          ),
                          child: Text(
                            v.type.toUpperCase(),
                            style: const TextStyle(
                                color: Color(0xFF34D399), fontSize: 10, fontWeight: FontWeight.bold),
                          ),
                        ),
                        const SizedBox(width: 6),
                        Container(
                          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                          decoration: BoxDecoration(
                            color: statusBg,
                            borderRadius: BorderRadius.circular(6),
                            border: Border.all(color: statusColor.withOpacity(0.5)),
                          ),
                          child: Text(
                            statusText,
                            style: TextStyle(color: statusColor, fontSize: 10, fontWeight: FontWeight.bold),
                          ),
                        ),
                        const SizedBox(width: 6),
                        Text(
                          '#${v.id}',
                          style: const TextStyle(color: Color(0xFF64748B), fontSize: 11, fontFamily: 'monospace'),
                        ),
                      ],
                    ),
                    const SizedBox(height: 4),
                    Text(
                      v.name,
                      style: const TextStyle(
                          color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14),
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                    const SizedBox(height: 2),
                    Text(
                      '${v.address} (${v.district}) â€¢ Chá»§: ${v.ownerName}',
                      style: const TextStyle(color: Color(0xFF94A3B8), fontSize: 11),
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                    const SizedBox(height: 4),
                    Row(
                      children: [
                        Text(v.price,
                            style: const TextStyle(
                                color: Color(0xFF10B981), fontWeight: FontWeight.bold, fontSize: 12)),
                        const SizedBox(width: 10),
                        const Icon(Icons.access_time, size: 12, color: Color(0xFF64748B)),
                        const SizedBox(width: 2),
                        Text(v.hours, style: const TextStyle(color: Color(0xFF64748B), fontSize: 11)),
                      ],
                    ),
                  ],
                ),
              ),

              // Action Buttons (Detail, Edit, Delete)
              Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  IconButton(
                    icon: const Icon(Icons.visibility_outlined, color: Color(0xFF60A5FA), size: 20),
                    tooltip: 'Xem chi tiáº¿t',
                    onPressed: () => _openViewDetailDialog(v),
                  ),
                  IconButton(
                    icon: const Icon(Icons.edit_outlined, color: Color(0xFF818CF8), size: 20),
                    tooltip: 'Chá»‰nh sá»­a',
                    onPressed: () => _openEditVenueDialog(v),
                  ),
                  IconButton(
                    icon: const Icon(Icons.delete_outline, color: Color(0xFFF87171), size: 20),
                    tooltip: 'XÃ³a sÃ¢n',
                    onPressed: () => _openDeleteVenueDialog(v),
                  ),
                ],
              ),
            ],
          ),

          // Action bar if PENDING approval
          if (v.isPending) ...[
            const SizedBox(height: 10),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
              decoration: BoxDecoration(
                color: const Color(0xFF0F172A),
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: const Color(0xFFFBBF24).withOpacity(0.3)),
              ),
              child: Row(
                children: [
                  const Icon(Icons.shield_outlined, color: Color(0xFFFBBF24), size: 16),
                  const SizedBox(width: 6),
                  const Expanded(
                    child: Text(
                      'YÃªu cáº§u Ä‘Äƒng bÃ i tá»« Chá»§ sÃ¢n cáº§n báº¡n phÃª duyá»‡t:',
                      style: TextStyle(color: Color(0xFFFBBF24), fontSize: 12, fontWeight: FontWeight.w500),
                    ),
                  ),
                  ElevatedButton.icon(
                    onPressed: () async {
                      await FirestoreService.updateVenueApproval(v.id, 'approved');
                      final updated = v.copyWith(approvalStatus: 'approved');
                      final idx = _venues.indexWhere((item) => item.id == v.id);
                      if (idx != -1) setState(() => _venues[idx] = updated);
                      _showToast('ÄÃ£ duyá»‡t Ä‘Äƒng bÃ i sÃ¢n "${v.name}" thÃ nh cÃ´ng!');
                    },
                    icon: const Icon(Icons.check_circle, size: 14),
                    label: const Text('Duyá»‡t ÄÄƒng', style: TextStyle(fontSize: 11.5, fontWeight: FontWeight.bold)),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: const Color(0xFF10B981),
                      foregroundColor: Colors.white,
                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                    ),
                  ),
                  const SizedBox(width: 8),
                  OutlinedButton.icon(
                    onPressed: () => _openRejectDialog(v),
                    icon: const Icon(Icons.cancel_outlined, size: 14),
                    label: const Text('Tá»« Chá»‘i', style: TextStyle(fontSize: 11.5)),
                    style: OutlinedButton.styleFrom(
                      foregroundColor: const Color(0xFFEF4444),
                      side: const BorderSide(color: Color(0xFFEF4444)),
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ],
      ),
    );
  }

  void _openRejectDialog(Venue v) {
    final reasonCtrl = TextEditingController(text: 'HÃ¬nh áº£nh chÆ°a rÃµ nÃ©t hoáº·c thiáº¿u báº£ng giÃ¡ chi tiáº¿t');
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: const Color(0xFF1E293B),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: const Row(
          children: [
            Icon(Icons.cancel, color: Color(0xFFEF4444)),
            SizedBox(width: 8),
            Text('Tá»« Chá»‘i BÃ i ÄÄƒng SÃ¢n', style: TextStyle(color: Colors.white, fontSize: 16)),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Nháº­p lÃ½ do tá»« chá»‘i Ä‘á»ƒ gá»­i pháº£n há»“i cho chá»§ sÃ¢n "${v.name}":',
                style: const TextStyle(color: Color(0xFF94A3B8), fontSize: 13)),
            const SizedBox(height: 10),
            _dialogTextField('LÃ½ Do Tá»« Chá»‘i *', reasonCtrl, 'VD: Cáº§n cáº­p nháº­t giáº¥y phÃ©p / áº£nh thá»±c táº¿'),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Há»§y', style: TextStyle(color: Color(0xFF94A3B8))),
          ),
          ElevatedButton(
            onPressed: () async {
              final reason = reasonCtrl.text.trim().isEmpty ? 'ChÆ°a Ä‘Ã¡p á»©ng tiÃªu chuáº©n kiá»ƒm duyá»‡t' : reasonCtrl.text.trim();
              await FirestoreService.updateVenueApproval(v.id, 'rejected', reason);
              final updated = v.copyWith(approvalStatus: 'rejected', rejectReason: reason);
              final idx = _venues.indexWhere((item) => item.id == v.id);
              if (idx != -1) setState(() => _venues[idx] = updated);
              Navigator.pop(ctx);
              _showToast('ÄÃ£ tá»« chá»‘i duyá»‡t bÃ i sÃ¢n "${v.name}"!', isError: true);
            },
            style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFFEF4444)),
            child: const Text('XÃ¡c Nháº­n Tá»« Chá»‘i', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }


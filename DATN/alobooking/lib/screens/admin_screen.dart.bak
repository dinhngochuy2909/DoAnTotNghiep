                            FirestoreService.updateCustomer(c);
                            _showToast('ÄÃ£ cáº­p nháº­t tráº¡ng thÃ¡i khÃ¡ch hÃ ng ${c.name}!');
                          } else if (action == 'delete') {
                            setState(() {
                              _customers.removeWhere((item) => item.id == c.id);
                            });
                            FirestoreService.deleteCustomer(c.id);
                            _showToast('ÄÃ£ xÃ³a khÃ¡ch hÃ ng ${c.name}!', isError: true);
